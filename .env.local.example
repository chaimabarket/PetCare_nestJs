# Copier ce fichier en .env.local et le remplir.

# Firebase : uniquement pour l'authentification (comptes, connexion, mots de passe).
# Console Firebase > Paramètres du projet > Vos applications > Application Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# MongoDB Atlas : stockage des profils et des notifications (serveur uniquement, jamais NEXT_PUBLIC_).
# Atlas > Database > Connect > Drivers. Autoriser son adresse IP dans Atlas > Network Access.
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net
MONGODB_DB=petcare

# Facultatif : adresse mise dans les liens de partage du carnet (QR code).
# En développement, l'adresse du PC sur le Wi-Fi (ex. http://192.168.1.20:3000) pour ouvrir les liens depuis un téléphone ;
# en production, le domaine du site. Vide : adresse du site ouvert dans le navigateur.
NEXT_PUBLIC_SHARE_ORIGIN=
