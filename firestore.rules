rules_version = '2';

// Firestore n'est plus utilisé : profils et notifications sont dans MongoDB (routes /api/*).
// Ces règles ferment tout accès direct depuis le navigateur.
// À publier (une fois les anciennes données récupérées si besoin) : npm run deploy:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
